# Copy to .env and fill in values before running locally (outside Docker).
# Docker Compose sets DATABASE_URL automatically via the compose environment block.

# Local Postgres (Docker):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookshelf
#
# Supabase (production) — use the "Transaction" pooler URL (port 6543) for
# serverless; use the direct URL (port 5432) for a persistent server like Render:
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookshelf

# JWT signing secret — use a long random string in production
SECRET_KEY=changeme-in-production

# Access token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Metadata provider for book search (currently only open_library is supported)
METADATA_PROVIDER=open_library

# LLM provider for the reading companion chat feature
# Get an API key at https://openrouter.ai/keys
# Use a free model for development (zero cost): openrouter/auto
# Swap to any OpenRouter model (e.g. anthropic/claude-sonnet-4-6) by changing LLM_MODEL only
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-key-here
LLM_MODEL=openrouter/auto
